# Copy this file to ".env" (start.command does it for you) and edit the values.
# ".env" is never committed to git.

# Your OpenRouter key (needed from Milestone 4; leave empty until then).
OPENROUTER_API_KEY=
# Model names are chosen in Milestone 4 after checking the live OpenRouter list.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=

# "mock" = fake LLM, no internet, no cost. "live" = real OpenRouter calls.
LLM_MODE=mock

# Language for the first start: en or de (parents can change it later in the parent area).
APP_LANGUAGE=en

# PIN for the parent area and for exiting the app. CHANGE THIS.
PARENT_PIN=1234
