# Copy this file to ".env" (start.command does it for you) and edit the values.
# ".env" is never committed to git.

# Your OpenRouter key (starts with sk-or-). Only needed for LLM_MODE=live.
OPENROUTER_API_KEY=
# Cheap, fast models with JSON output (checked against the live OpenRouter list).
# Leave empty to use these defaults, or paste another model id from openrouter.ai/models.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# "mock" = fake LLM, no internet, no cost. "live" = real OpenRouter calls.
LLM_MODE=mock
# Most OpenRouter requests allowed per day (a safety brake against surprise bills).
DAILY_REQUEST_CAP=200

# Language for the first start: en or de (parents can change it later in the parent area).
APP_LANGUAGE=en

# PIN for the parent area and for exiting the app. CHANGE THIS.
PARENT_PIN=1234
