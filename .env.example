# Copy this file to ".env" (start.command does it for you) and edit the values.
# ".env" is never committed to git.

# Your OpenRouter key (starts with sk-or-). Only needed for LLM_MODE=live.
OPENROUTER_API_KEY=
# Free models with JSON output (":free" = no cost). Leave empty to use these defaults,
# or paste another model id from openrouter.ai/models. Run scripts/try_models.py to compare.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4-flash-0731:free

# "off" = built-in words and sentences only: no internet needed, nothing is ever sent anywhere.
# "mock" = fake LLM for development. "openrouter" (or "live") = real OpenRouter calls (needs the key above, a
# "plus" licence, and a parent switching it on in the parent area under "Extra: online helper").
LLM_MODE=off
# Most OpenRouter requests Tippy sends per day. Free accounts with no credit are limited
# by OpenRouter to 50 a day, so 45 keeps you safely below it. With 10 USD of credit
# the free limit is 1000 a day and you can raise this.
DAILY_REQUEST_CAP=45

# Language for the first start: en or de (parents can change it later in the parent area).
APP_LANGUAGE=en

# Optional. Leave this out: Tippy asks the parent to choose a PIN on the first start.
# PARENT_PIN=

# Development only: switch on every licensed feature (Plus: online helper, printing; School: classroom
# and portable mode) without a licence file. Leave it out in a real install.
# DEV_UNLOCK_ALL=true
